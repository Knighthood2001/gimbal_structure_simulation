<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gimbal_gazebo_config">

  <!-- 1. 迁移transmission（关节与控制器的映射，仅Gazebo需要） -->
  <transmission name="root_to_low_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="root_to_low_joint"> <!-- 必须与核心模型中的关节名一致 -->
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="root_to_low_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="low_to_high_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="low_to_high_joint"> <!-- 与核心模型关节名一致 -->
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="low_to_high_motor">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/</robotNamespace>
    </plugin>
  </gazebo>

</robot>